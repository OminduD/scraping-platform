PROCESSED_DATA_DIR=./data/processed

# ── Scraping ──────────────────────────────────────────
CRAWL_DELAY=1.5
MAX_RETRIES=3
CONCURRENT_REQUESTS=8

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
